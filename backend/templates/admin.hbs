<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Classic Studio · Admin</title>
    <style>body{margin:0;background:#11131a;color:#eef1f7;font:15px system-ui,sans-serif}.shell{max-width:860px;margin:72px auto;padding:0 24px}.eyebrow{color:#8ab4ff;text-transform:uppercase;letter-spacing:.12em;font-size:12px}h1{font-size:38px;margin:12px 0 28px}.cards{display:flex;gap:16px}.card{background:#1c202b;border:1px solid #303748;border-radius:12px;padding:24px;min-width:180px}.number{font-size:32px;font-weight:700;margin-top:8px}</style>
  </head>
  <body><main class="shell"><div class="eyebrow">Classic Studio</div><h1>Administration</h1><section class="cards"><article class="card">Visible projects<div class="number">{{projects}}</div></article><article class="card">Users reported by store<div class="number">{{users}}</div></article></section></main></body>
</html>
