# Node deployment only: MongoDB Atlas uses TCP and cannot be connected to directly by a Cloudflare Worker.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/classic?retryWrites=true&w=majority
MONGODB_DB=classic
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
CORS_ORIGINS=https://app.example.com,http://localhost:5173
PORT=8787
APP_ENV=development
# Worker deployment: HTTPS endpoint of the Node API or a compatible data adapter.
API_PROXY_URL=https://api.example.com
